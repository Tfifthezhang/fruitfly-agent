include README.md GETTING_STARTED.md CONFIGURATION.md CONTRIBUTING.md AGENTS.md
include LICENSE THIRD_PARTY_NOTICES.md .gitignore
include assets/logo.svg
recursive-include fruitfly_agent *.py *.md
recursive-include fruitfly_agent/experiments/templates *.yaml
recursive-include fruitfly_agent/run/configuration/templates *.yaml
recursive-include eval *.py *.md
recursive-include tests *.py *.md *.json *.yaml
recursive-include examples *.py *.md *.json *.txt *.yaml
recursive-include .github *.yml
prune .fruitfly
prune .venv
prune .claude
prune .codex
prune .agents
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store secrets.env
exclude .env .env.*
exclude models.yaml
include examples/configuration/.env.example
