# Optional first-run compatibility when .fruitfly/config.yaml is not saved yet.
# Prefer selecting and saving the model with interactive /config.
# FRUITFLY_MODEL_PROFILE=your-profile

# Secrets referenced by .fruitfly/models.yaml api_key_env fields.
# Daily and default model catalogs may both reference this variable.
# Use distinct api_key_env names only when separate credentials are wanted.
# Both DeepSeek model examples use this model credential.
DEEPSEEK_API_KEY=

# Optional web-search service credential. Enable the matching backend in /config.
# Model, search and fetch use separate variables; api_key_env can select a shared key.
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_FETCH_API_KEY=
# Direct web_fetch does not require a key.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional SSH execution environment; account and password are both secrets.
# Configure only these variable names in ssh-env parameters, never their values.
FRUITFLY_SSH_USERNAME=
FRUITFLY_SSH_PASSWORD=
